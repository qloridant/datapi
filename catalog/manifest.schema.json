{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Algorithm Manifest",
  "oneOf": [
    { "$ref": "#/$defs/algorithm" },
    { "$ref": "#/$defs/package" }
  ],
  "$defs": {
    "algorithm": {
      "type": "object",
      "required": ["id", "dct:title", "runtime", "entrypoint", "input_schema", "output_schema"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string", "default": "0.1.0" },
        "description": { "type": "string" },
        "org": { "type": "string" },
        "runtime": {
          "type": "object",
          "required": ["language"],
          "properties": {
            "language": { "type": "string" },
            "version": { "type": "string" },
            "primary": { "type": "boolean" }
          }
        },
        "entrypoint": {
          "type": "object",
          "required": ["type", "target"],
          "properties": {
            "type": { "type": "string" },
            "target": { "type": "string" },
            "build_artifact": { "type": "string" }
          }
        },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "resources": {
          "type": "object",
          "properties": {
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "cpu": { "type": "number" },
            "memory_bytes": { "type": "integer" }
          }
        },
        "source": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sample_inputs": { "type": "object" },
        "license": { "type": ["string", "null"] },
        "metadata_raw": { "type": "object" },
        "security": { "type": "object" },
        "tags": { "type": "array", "items": { "type": "string" } },

        "dct:identifier": { "type": "string" },
        "dct:title": { "type": "string" },
        "cv:hasChannel": {
          "type": "object",
          "properties": {
            "foaf:page": { "type": "string" },
            "dct:description": { "type": "string" }
          }
        },
        "dct:source": {
          "description": "Algorithm-level dct:source: provenance links to the exact code (an array), mirroring the real metadata.jsonld's per-service dct:source. Distinct from the sibling 'source' property above, which lists local build paths used by adapters. NOTE: at package level (see $defs/package) the same 'dct:source' key instead holds a single object mirroring the aggregator's schema:SoftwareSourceCode node -- this shape difference is intentional, not an inconsistency.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "type": "string" } }
          }
        },
        "franceconnect_mapping": {
          "type": "object",
          "description": "Mapping between France Connect claims and algorithm input fields. Uses hybrid approach: global defaults + per-algorithm overrides.",
          "properties": {
            "mappings": {
              "type": "object",
              "description": "Mapping rules per input field. Key is JSON path in input_schema (e.g., 'data.age'), value is FC source path, a reference to default mapping (e.g., '$default.age'), or null for manual input.",
              "additionalProperties": {
                "oneOf": [
                  { "type": "string", "description": "FC claim path (e.g., 'birthdate') or default mapping reference (e.g., '$default.age')" },
                  { "type": "null", "description": "Field must be provided manually by user" },
                  {
                    "type": "object",
                    "description": "Extended mapping configuration",
                    "properties": {
                      "source": { "type": ["string", "null"], "description": "FC claim path (e.g., 'claims.birthdate') or null" },
                      "transform": { "type": "string", "description": "Name of transformation function (e.g., 'date_to_age')" },
                      "default": { "description": "Default value if FC data not available" },
                      "label": { "type": "string", "description": "Human-readable label for the field" },
                      "required": { "type": "boolean", "description": "Whether field is required (default: true)" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "default_mapping_ref": {
              "type": "string",
              "description": "Reference to default mapping configuration name (e.g., 'default_v1'). If omitted, uses global defaults."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": ["algorithms"],
      "properties": {
        "algorithms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/algorithm" }
        },
        "org": { "type": "string" },
        "license": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },

        "dct:source": {
          "description": "Package-level dct:source: mirrors the real metadata.jsonld aggregator node, whose dct:source points to a single schema:SoftwareSourceCode object -- NOT an array of provenance links like the per-algorithm 'dct:source' in $defs/algorithm. Same key, different shape by design: the aggregator references one SoftwareSourceCode, each service references specific lines of code.",
          "type": "object",
          "properties": {
            "schema:codeRepository": { "type": "string" },
            "schema:programmingLanguage": { "type": "array", "items": { "type": "string" } },
            "schema:softwareVersion": { "type": "string" }
          }
        },
        "franceconnect_mapping": {
          "type": "object",
          "description": "Default France Connect mapping for all algorithms in this package. Individual algorithms can override.",
          "properties": {
            "mappings": {
              "type": "object",
              "description": "Default mapping rules for the package. Same structure as algorithm-level franceconnect_mapping.mappings.",
              "additionalProperties": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "null" },
                  {
                    "type": "object",
                    "properties": {
                      "source": { "type": ["string", "null"] },
                      "transform": { "type": "string" },
                      "default": { },
                      "label": { "type": "string" },
                      "required": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
