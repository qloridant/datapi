{
  "id": "openfisca-france-pass-culture",
  "record": "https://regles.data.gouv.fr/regles/ministere-culture/openfisca-france-pass-culture",
  "public": true,
  "runtime": {
    "language": "openfisca",
    "version": "175.1.4",
    "primary": true
  },
  "entrypoint": {
    "type": "openfisca:variables",
    "target": "openfisca_france",
    "outputs": [
      "pass_culture"
    ],
    "inputs": [
      "date_naissance"
    ]
  },
  "input_schema": {
    "type": "object",
    "required": [
      "period",
      "date_naissance"
    ],
    "properties": {
      "period": {
        "type": "string",
        "title": "Période",
        "description": "Mois du calcul, au format AAAA-MM, par exemple 2026-01.",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      },
      "date_naissance": {
        "type": "string",
        "format": "date",
        "title": "Date de naissance"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "pass_culture"
    ],
    "properties": {
      "pass_culture": {
        "type": "number",
        "title": "Montant du pass culture"
      }
    },
    "additionalProperties": false
  },
  "sample_inputs": {
    "period": "2025-04",
    "date_naissance": "2007-02-01"
  },
  "resources": {
    "timeout_seconds": 10
  }
}
